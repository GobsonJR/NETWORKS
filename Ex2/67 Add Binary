char* addBinary(char* a, char* b) {
    int i, j, carry = 0;
    int count = 0, count1 = 0;

    for(i = 0; a[i] != '\0'; i++)
        count++;

    for(i = 0; b[i] != '\0'; i++)
        count1++;

    char *result = (char*)malloc(10005);

    i = count - 1;
    j = count1 - 1;

    int index = 0;

    while(i >= 0 || j >= 0 || carry != 0) {

        int sum = carry;

        if(i >= 0) {
            sum = sum + (a[i] - '0');
            i--;
        }

        if(j >= 0) {
            sum = sum + (b[j] - '0');
            j--;
        }

        result[index] = (sum % 2) + '0';
        carry = sum / 2;
        index++;
    }

    result[index] = '\0';

    i = 0;
    j = index - 1;

    while(i < j) {
        char temp = result[i];
        result[i] = result[j];
        result[j] = temp;
        i++;
        j--;
    }

    return result;
}
