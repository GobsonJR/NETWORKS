#include <stdio.h>
#define MAX 100

int data[MAX], stuffed[MAX], destuffed[MAX];
int flag[] = {0,1,1,1,1,1,1,0};
int flagLen = 8;

void printBits(char *label, int arr[], int n) {
    printf("%-15s : ", label);
    int i;
    for(i = 0; i < n; i++)
        printf("%d", arr[i]);
    printf("\n");
}

int main() {
    int n, i;
    int ones = 0;
    int j = 0;
    int errorDetected = 0;
    printf("Enter number of bits : ");
    if (scanf("%d", &n) != 1) return 0;

    printf("Enter bits (0/1):\n");
    for(i = 0; i < n; i++) {
        if (scanf("%d", &data[i]) != 1) return 0;
    }

    printf("\n--- ENCODING PROCESS ---\n");
    printBits("Original Data", data, n);

    printf("\nStuffing analysis:\n");
    for(i = 0; i < n; i++) {
        stuffed[j++] = data[i];
        if(data[i] == 1) {
            ones++;
        } else {
            ones = 0;
        }

        if(ones == 5) {
            printf("  -> Found 5 consecutive 1s at index %d. Stuffing a '0' bit.\n", i);
            stuffed[j++] = 0;
            ones = 0;
        }
    }

    int stuffedLen = j;
    int framed[MAX];
    int k = 0;

    for(i = 0; i < flagLen; i++)
        framed[k++] = flag[i];

    for(i = 0; i < stuffedLen; i++)
        framed[k++] = stuffed[i];

    for(i = 0; i < flagLen; i++)
        framed[k++] = flag[i];

    int framedLen = k;

    printf("\n");
    printBits("Stuffed Data", stuffed, stuffedLen);
    printBits("Framed Data", framed, framedLen);

    printf("\n=== ERROR INJECTION ===\n");
    int errIdx;
    printf("Enter index to inject a 1-bit error (0 to %d, or -1 for no error): ", framedLen - 1);
    if (scanf("%d", &errIdx) == 1 && errIdx >= 0 && errIdx < framedLen) {
        framed[errIdx] ^= 1;
        printf("  -> Altered bit at frame index %d!\n", errIdx);
        printBits("Corrupted Frame", framed, framedLen);
    } else {
        printf("  -> Processing without introducing any errors.\n");
    }

    printf("\n=== DECODING PROCESS ===\n");
    printf("Removing flags and processing bits from index %d to %d.\n", flagLen, framedLen - flagLen - 1);
    ones = 0;
    j = 0;
    printf("\nDestuffing analysis:\n");
    for(i = flagLen; i < framedLen - flagLen; i++) {
        if(framed[i] == 1) {
            ones++;
        } else {
            ones = 0;
        }
        destuffed[j++] = framed[i];
        if(ones == 5) {
            printf("  -> Found 5 consecutive 1s at frame index %d. Destuffing next bit.\n", i);
            i++;

            if(i >= framedLen - flagLen || framed[i] != 0) {
                errorDetected = 1;
                break;
            }
            printf("  -> Successfully removed stuffed '0' at frame index %d.\n", i);
            ones = 0;
        }
    }
    if (!errorDetected) {
        if (j != n) {
            errorDetected = 1;
        } else {
            for(i = 0; i < n; i++) {
                if (destuffed[i] != data[i]) {
                    errorDetected = 1;
                    break;
                }
            }
        }
    }

    printf("\n=== OUTPUT ===\n");
    if (errorDetected) {
        printf("Result          : ERROR DETECTED! Frame payload was corrupted during transmission.\n");
        printBits("Expected Data", data, n);
        printBits("Received Data", destuffed, j);
    } else {
        printf("Result          : SUCCESS! Data received with zero errors.\n");
        printBits("Destuffed Data", destuffed, j);
    }
    return 0;
}
